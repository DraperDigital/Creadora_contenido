!src/contenido_bionico/shared/quote-template/*.png
*.jpg
*.jpg.*
*.jpeg
*.jpeg.*
*.gif
*.gif.*

# Standard pipeline audio assets must be committed with the repo.
!audio_library/
!audio_library/**
audio_library/.DS_Store
audio_library/**/.DS_Store
# Runtime sidecars written into the audio library (loudness measurements,
# recent music picks) — never source assets.
audio_library/.loudness_cache.json
audio_library/.recent_picks.json
