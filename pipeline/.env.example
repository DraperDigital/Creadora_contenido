# Optional local secrets for contenido-bionico.
# Most users should run `contenido-bionico setup` instead of editing this manually.

# Required only when setup chooses AI engine = API key.
ANTHROPIC_API_KEY=

# Required for ElevenLabs Speech to Text. The key must include speech_to_text permission.
ELEVENLABS_API_KEY=

# Optional advanced debug toggles (normally leave unset; uncomment to enable):
#   BIONICO_ALLOW_UNREADY=1                 # bypass the "setup complete" gate
#   BIONICO_DISABLE_DESILENCE=1             # skip the up-front silence capping; the pipeline runs on the original video as-is
#   BIONICO_STRICT_ANIMATIONS=1             # reject degraded/force-rendered animation segments (by default they are accepted as "passed_degraded")
#   BIONICO_SKILL_HOME=/custom/skills/path  # override where skills get installed
